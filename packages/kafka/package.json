{
    "name": "@message-queue-toolkit/kafka",
    "version": "2.0.1",
    "engines": {
        "node": ">= 22.22.0"
    },
    "private": false,
    "license": "MIT",
    "homepage": "https://github.com/kibertoad/message-queue-toolkit",
    "repository": {
        "type": "git",
        "url": "git://github.com/kibertoad/message-queue-toolkit.git"
    },
    "description": "Kafka adapter for message-queue-toolkit",
    "keywords": [
        "message",
        "queue",
        "queues",
        "abstract",
        "common",
        "utils",
        "notification",
        "kafka"
    ],
    "files": [
        "README.md",
        "LICENSE",
        "dist"
    ],
    "maintainers": [
        {
            "name": "Igor Savin",
            "email": "kibertoad@gmail.com"
        }
    ],
    "type": "module",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "pnpm run clean && tsc --project tsconfig.build.json",
        "clean": "rimraf dist",
        "test": "vitest run --typecheck",
        "test:coverage": "pnpm run test --coverage",
        "lint": "biome check . && tsc",
        "lint:fix": "biome check --write .",
        "docker:start": "docker compose up -d kafka",
        "docker:stop": "docker compose down",
        "prepublishOnly": "pnpm run lint && pnpm run build"
    },
    "dependencies": {
        "@lokalise/node-core": "^14.12.0",
        "@lokalise/universal-ts-utils": "^4.12.0",
        "@platformatic/kafka": "^2.14.0"
    },
    "peerDependencies": {
        "@message-queue-toolkit/core": ">=27.0.0",
        "@message-queue-toolkit/schemas": ">=7.0.0",
        "zod": "^4.5.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@lokalise/biome-config": "^4.0.0",
        "@lokalise/tsconfig": "^5.0.0",
        "@message-queue-toolkit/core": "workspace:*",
        "@message-queue-toolkit/schemas": ">=7.2.0",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "awilix": "^13.0.5",
        "awilix-manager": "^7.1.0",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5",
        "zod": "^4.6.5"
    }
}
